# ── App ───────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database (SQLite for dev, switch to PostgreSQL for prod) ──────
POSTGRES_URL=sqlite+aiosqlite:///./tenderai.db
# POSTGRES_URL=postgresql+asyncpg://tenderai:tenderai@localhost:5432/tenderai

# ── Redis (optional in dev — Celery won't work without it) ────────
REDIS_URL=redis://localhost:6379/0

# ── Qdrant (set QDRANT_AVAILABLE=False to disable if not running) ─
QDRANT_URL=http://localhost:6333
QDRANT_AVAILABLE=False

# ── Auth ──────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-random-secret

# ── LLM Providers (fill at least one) ────────────────────────────
FAST_LLM_MODEL=groq/llama-3.3-70b-versatile
QUALITY_LLM_MODEL=groq/llama-3.3-70b-versatile
VISION_LLM_MODEL=openrouter/qwen/qwen-2.5-vl-72b-instruct

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Embeddings ────────────────────────────────────────────────────
# "local" = free, no API needed (recommended for dev)
# "gemini" = best quality, needs GEMINI_API_KEY
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_LOCAL=all-MiniLM-L6-v2

# ── OCR ───────────────────────────────────────────────────────────
PRIMARY_OCR=paddle
FALLBACK_OCR=tesseract

# ── Reranker ──────────────────────────────────────────────────────
# "bge" = local, free | "jina" = API | "none" = disabled
RERANKER=none

JINA_API_KEY=

# ── Indian Tender Sources (GeM, CPPP, Railways, PSUs) ────────────────
GEM_API_KEY=

# ── Ingestion Layer: Crawlers & AI Search ────────────────────────────
APIFY_API_TOKEN=
FIRECRAWL_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker
SERPAPI_KEY=
TAVILY_API_KEY=
EXA_API_KEY=

# ── Optional Connector Plug-ins ───────────────────────────────────────
# Enable/disable each ingestion connector independently.
# Connectors are skipped at startup when their flag is False (default).
# Priority targets: GeM, CPPP, CPWD, MES, DRDO, ISRO, Indian Railways,
#   NHAI, Smart Cities, HUDCO, State PWDs, Municipal Corps, Defence, IITs/NITs.
# Keywords: Construction 3D Printing, Concrete Printing, Additive Manufacturing,
#   Construction Robotics, Digital Fabrication, Smart Construction, etc.
ENABLE_APIFY=false
ENABLE_FIRECRAWL=false
ENABLE_CRAWL4AI=false
ENABLE_PLAYWRIGHT=false
ENABLE_BROWSERBASE=false
ENABLE_BRIGHTDATA=false
ENABLE_SERPAPI=false
ENABLE_TAVILY=false
ENABLE_EXA=false
ENABLE_RAPIDAPI=false

RAPIDAPI_KEY=

# ── Email ─────────────────────────────────────────────────────────
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@tenderai.com

# ── Monitoring ────────────────────────────────────────────────────
SENTRY_DSN=
